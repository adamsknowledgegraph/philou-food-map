{
  "name": "food-reco-paris",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "db:migrate": "tsx scripts/db_migrate.ts",
    "db:seed": "tsx prisma/seed.ts",
    "sources:discover": "tsx scripts/discover_web_sources.ts",
    "sources:ingest": "tsx scripts/ingest_web_sources.ts",
    "extract": "tsx scripts/extract_places_from_sources.ts",
    "normalize": "tsx scripts/normalize_places.ts",
    "dedupe": "tsx scripts/dedupe_places.ts",
    "geocode": "tsx scripts/geocode_places.ts",
    "google:enrich": "tsx scripts/enrich_google_places.ts",
    "images:enrich-web": "tsx scripts/enrich_website_images.ts",
    "maps:export-google": "tsx scripts/export_google_mymaps.ts",
    "maps:refresh-links": "tsx scripts/refresh_google_maps_urls.ts",
    "review:export": "tsx scripts/export_review_csv.ts",
    "review:import": "tsx scripts/import_review_csv.ts",
    "instagram:collect": "tsx scripts/instagram_collect.ts",
    "instagram:import": "tsx scripts/instagram_import.ts",
    "instagram:transcribe": "tsx scripts/transcribe_videos.ts",
    "instagram:ocr": "tsx scripts/ocr_video_frames.ts && tsx scripts/ocr_screenshots.ts",
    "instagram:extract": "tsx scripts/extract_instagram_places.ts",
    "pipeline:quick": "npm run sources:discover && npm run sources:ingest && npm run extract && npm run normalize && npm run dedupe && npm run geocode && npm run review:export",
    "pipeline:full": "npm run pipeline:quick && npm run instagram:collect && npm run instagram:import && npm run instagram:transcribe && npm run instagram:ocr && npm run instagram:extract"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^6.19.0",
    "better-sqlite3": "^12.9.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.11.0",
    "next": "16.2.4",
    "papaparse": "^5.5.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
